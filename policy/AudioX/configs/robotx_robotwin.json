{
    "model_type": "robot_diffusion",
    "action_dim": 16,
    "action_chunk_size": 64,
    "model": {
        "diffusion": {
            "type": "dit",
            "diffusion_objective": "v",
            "cross_attention_cond_ids": ["prompt", "video", "proprio"],
            "global_cond_ids": [],
            "input_concat_ids": [],
            "prepend_cond_ids": [],
            "config": {
                "io_channels": 16,
                "patch_size": 1,
                "embed_dim": 768,
                "cond_token_dim": 768,
                "project_cond_tokens": true,
                "global_cond_dim": 0,
                "depth": 12,
                "num_heads": 12,
                "transformer_type": "continuous_transformer",
                "global_cond_type": "prepend"
            }
        },
        "conditioning": {
            "cond_dim": 768,
            "configs": [
                {
                    "id": "prompt",
                    "type": "t5",
                    "config": {
                        "t5_model_name": "t5-base",
                        "max_length": 64,
                        "enable_grad": false
                    }
                },
                {
                    "id": "video",
                    "type": "clip",
                    "config": {
                        "clip_model_name": "clip-vit-base-patch32",
                        "video_fps": 3,
                        "out_features": 32,
                        "in_features": 150,
                        "enable_grad": false
                    }
                },
                {
                    "id": "proprio",
                    "type": "trajectory",
                    "config": {
                        "state_dim": 16,
                        "mode": "direct"
                    }
                }
            ]
        }
    },
    "training": {
        "use_ema": true,
        "log_loss_info": true,
        "cfg_dropout_prob": 0.1,
        "timestep_sampler": "logit_normal",
        "optimizer_configs": {
            "diffusion": {
                "optimizer": {
                    "type": "AdamW",
                    "config": {
                        "lr": 1e-4,
                        "betas": [0.9, 0.999],
                        "weight_decay": 0.01
                    }
                },
                "scheduler": {
                    "type": "CosineAnnealingLR",
                    "config": {
                        "T_max": 100000,
                        "eta_min": 1e-6
                    }
                }
            }
        }
    },
    "dataset": {
        "data_dir": "/path/to/robotwin/data",
        "embodiment": "franka_dual",
        "action_chunk_size": 64,
        "image_size": 224,
        "camera_names": ["front", "left_wrist", "right_wrist"],
        "normalize": true,
        "augment": true,
        "batch_size": 32,
        "num_workers": 8
    }
}
